{
  "name": "entropylab",
  "version": "0.1.3",
  "description": "Self-contained, air-gapped Bitcoin key and wallet calculator",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/build.mjs --clean",
    "test": "node --test test/*.test.mjs",
    "test:validate": "node --test test/validate.test.mjs",
    "test:browser": "node --test test/browser.test.mjs",
    "verify": "node scripts/verify-site.mjs",
    "ci": "npm test && npm run build && npm run verify"
  },
  "keywords": [
    "bitcoin",
    "bip39",
    "bip32",
    "air-gapped",
    "offline",
    "wallet"
  ],
  "engines": {
    "node": ">=18"
  }
}
